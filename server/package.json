{
  "name": "umbrastudio-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Umbra Studio MCP server —— 本地设计稿工具，见 ../doc/00-MCP 工具契约.md",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "umbradesign": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "ui": "node dist/ui.js",
    "check": "tsc -p . --noEmit",
    "selftest": "node dist/selftest.js",
    "lifecycletest": "node dist/lifecycletest.js",
    "rendertest": "node dist/rendertest.js",
    "agenttest": "node dist/agenttest.js",
    "incoming": "node dist/incoming.js",
    "outgoing": "node dist/outgoing.js",
    "filetest": "node dist/filetest.js",
    "captest": "npm run build && node dist/captest.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.63.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
