{
  "name": "umbradesign-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UmbraDesign MCP server —— 本地设计稿工具，见 ../doc/00-MCP 工具契约.md",
  "engines": { "node": ">=20" },
  "bin": { "umbradesign": "./dist/index.js" },
