{
  "name": "umbrastudio-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Umbra Studio 桌面壳（Electron）：主进程起核心，自带 Chromium 跑体检",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win",
    "dist:dir": "electron-builder --mac --arm64 --dir",
    "packtest": "node packtest.mjs",
    "shelltest": "node shelltest.mjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.umbrastudio.app",
    "productName": "Umbra Studio",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "core/server/dist"
      },
      {
        "from": "../server/node_modules",
        "to": "core/server/node_modules",
        "filter": [
          "**/*",
          "!typescript/**",
          "!@types/**",
          "!.bin/**",
          "!**/*.md",
          "!**/*.map"
        ]
      },
      {
        "from": "../server/package.json",
        "to": "core/server/package.json"
      },
      {
        "from": "../runtime",
        "to": "core/runtime"
      },
      {
        "from": "../doc",
        "to": "core/doc",
        "filter": [
          "*.md"
        ]
      },
      {
        "from": "../ui",
        "to": "core/ui",
        "filter": [
          "**/*",
          "!_incoming/**"
        ]
      },
      {
        "from": "../plugins",
        "to": "core/plugins"
      },
      {
        "from": "../app/dist",
        "to": "core/app/dist"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "afterPack": "./afterPack.cjs"
  }
}
