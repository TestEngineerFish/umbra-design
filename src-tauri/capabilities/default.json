{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "compare"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "shell:default",
    "shell:allow-open",
    "shell:allow-kill",
    "shell:allow-spawn",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-set-title",
    "core:window:allow-set-focus"
  ]
}
