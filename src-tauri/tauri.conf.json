{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UmbraDesign",
  "version": "0.1.0",
  "identifier": "com.umbradesign.app",
  "build": {
    "frontendDist": "../server/ui",
    "beforeDevCommand": "npm --prefix server run build",
    "beforeBuildCommand": "npm --prefix server run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UmbraDesign",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
